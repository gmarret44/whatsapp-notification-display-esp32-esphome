# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is git-ignored and must NEVER be committed.

wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"

# Generate with: esphome secrets or `openssl rand -base64 32`
api_encryption_key: "generate_a_base64_key_here"

# Password for the fallback AP hotspot (min. 8 characters)
fallback_password: "at_least_8_characters"
